{
  "schema_version": "1.0.0",
  "contract": "bcsentinel-x3-exception-transparency-v1",
  "authority": {
    "exception_management": "business_central",
    "snapshot_write": "business_central_machine_credential_only",
    "dashboard": "read_only"
  },
  "history_rule": "Reports and dashboards for a historical scan must use the immutable exception snapshot captured for that scan, never the current active-exception list.",
  "snapshot_fields": [
    "scan_id",
    "tenant_id",
    "company_id",
    "source_exception_entry_no",
    "table_id",
    "record_system_id",
    "record_no",
    "record_caption",
    "issue_code",
    "reason",
    "exception_created_by",
    "exception_created_at_utc",
    "captured_at_utc"
  ],
  "read_model": {
    "path": "/scans/{scan_id}/exceptions",
    "properties": ["exception_count", "exceptions_applied", "exceptions"]
  },
  "write_model": {
    "path": "/scans/{scan_id}/exception-snapshot",
    "immutable_after_first_capture": true,
    "bearer_dashboard_write_forbidden": true
  }
}
